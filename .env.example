# Firebase Project Configuration (get from Firebase Console -> Project Settings)
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# Firebase App Check (REQUIRED for #BuildHybridAI Hackathon)
# For local development / judging, enable debug token in Firebase Console -> App Check
VITE_FIREBASE_APP_CHECK_SITE_KEY=your_recaptcha_v3_site_key
VITE_FIREBASE_APP_CHECK_DEBUG_TOKEN=true

# Optional: Override Cloud Gemini fallback model name (default: gemini-2.5-flash)
VITE_GEMINI_CLOUD_MODEL=gemini-2.5-flash
